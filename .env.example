PORT=4000

# Password admin will type to view uploaded photos/videos
ADMIN_PASSWORD=choose-a-strong-password

# The Google Drive folder that will receive all uploads (see README for how to get this)
DRIVE_FOLDER_ID=paste-your-drive-folder-id-here

# Path to the service account JSON key file (see README)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json
